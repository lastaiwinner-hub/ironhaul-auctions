<section data-inbox>
  <div class="ops-welcome"><div><span class="ops-eyebrow">CUSTOMER CONVERSATIONS</span><h2>A helpful human. Right here.</h2><p>Answer questions while buyers are exploring your lots.</p></div><label class="ops-availability"><input type="checkbox" data-available> Show me as available</label></div>
  <p class="ops-footnote">Availability stays online while this inbox is visible and selected. Replies appear in the visitor’s browser. No automatic email notifications are sent.</p>
  <div class="ops-inbox"><aside class="ops-thread-sidebar"><div class="ops-inbox-filters"><label>Conversations<select data-thread-status><option value="open">Open</option><option value="closed">Closed</option></select></label><label>Find a conversation<input type="search" data-thread-search placeholder="Name or email"></label></div><p data-inbox-status role="status">Loading conversations…</p><div data-thread-list class="ops-thread-list"></div></aside>
    <section class="ops-conversation"><div data-conversation-empty class="ops-empty"><span class="ops-empty-mark" aria-hidden="true">↗</span><h3>Your next conversation starts here.</h3><p>Choose a conversation to see its history and reply.</p></div><div data-conversation hidden><header class="ops-conversation-head"><div><h3 data-contact-name></h3><p data-contact-meta></p></div><button class="ops-secondary" type="button" data-thread-toggle>Close conversation</button></header><div data-chat-messages class="ops-chat-messages" role="log" aria-live="polite" aria-label="Conversation messages"></div><form data-reply-form><label>Reply to visitor<textarea name="message" required rows="3" maxlength="2000" placeholder="Write a helpful reply…"></textarea></label><div class="ops-reply-actions"><span data-reply-status role="status"></span><button class="ops-primary" type="submit">Send reply ↗</button></div></form></div></section>
  </div>
</section>
