<%- include('../partials/audience-overview') %>
<section class="ops-card"><div class="ops-card-head"><h3>Campaign performance</h3><span>Visits within the selected period</span></div><div class="ops-table" data-campaigns></div></section>
<section class="ops-card ops-campaign-builder"><div><span class="ops-eyebrow">BETTER ATTRIBUTION</span><h3>Give every campaign a clear source.</h3><p>Use a tagged link in your Facebook or Instagram ad, bio, or post. This helps identify traffic when apps hide their referrer.</p></div><form data-campaign-builder><label>Destination on this site<input name="path" value="/inventory" required></label><label>Platform<select name="source"><option value="facebook">Facebook</option><option value="instagram">Instagram</option><option value="tiktok">TikTok</option><option value="email">Email</option></select></label><label>Medium<select name="medium"><option value="paid_social">Paid social</option><option value="organic_social">Organic social</option><option value="email">Email</option></select></label><label>Campaign name<input name="campaign" required maxlength="100" placeholder="october-equipment-sale" pattern="[A-Za-z0-9_-]+"></label><button class="ops-primary">Create link</button><label class="ops-wide">Campaign link<input data-campaign-link readonly aria-label="Generated campaign link"></label><button type="button" data-copy-link class="ops-secondary">Copy link</button><p data-link-status role="status"></p></form></section>
