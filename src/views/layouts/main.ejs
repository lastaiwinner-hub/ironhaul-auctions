<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title || `${brand.name} — ${brand.tagline}` %></title>
  <meta name="description" content="<%= metaDescription || brand.description %>">
  <meta name="theme-color" content="<%= brand.theme.ink %>">

  <meta property="og:type" content="website">
  <meta property="og:site_name" content="<%= brand.name %>">
  <meta property="og:title" content="<%= title || brand.name %>">
  <meta property="og:description" content="<%= metaDescription || brand.description %>">
  <meta property="og:url" content="<%= baseUrl %><%= currentPath %>">
  <meta name="twitter:card" content="summary_large_image">

  <link rel="stylesheet" href="/css/fonts.css">
  <link rel="stylesheet" href="/css/app.css">
  <link rel="icon" href="/img/favicon.svg?v=heavyline-1" type="image/svg+xml">

  <%- include('../partials/theme-tokens') %>
  <link rel="stylesheet" href="/css/redesign.css?v=marketplace-2">
  <link rel="stylesheet" href="/css/dealership.css?v=heavyline-2">
  <link rel="stylesheet" href="/css/ironlot-polish.css?v=heavyline-2">
  <link rel="stylesheet" href="/css/product.css?v=heavyline-2">
  <link rel="stylesheet" href="/css/ironlot-motion.css?v=heavyline-2">
  <link rel="stylesheet" href="/css/auction-room.css?v=heavyline-2">
  <link rel="stylesheet" href="/css/heavyline-theme.css?v=1">
  <%- style %>
</head>
<body class="brand-equipment <%= bodyClass || '' %>">
  <a href="#main" class="sr-only">Skip to content</a>

  <%- include('../partials/header') %>

  <% if (flashes && flashes.length) { %>
    <div class="flashes wrap" style="padding-top:14px">
      <% flashes.forEach(function (f) { %>
        <div class="alert alert-<%= f.type === 'warning' ? 'warning' : (f.type === 'error' ? 'error' : (f.type === 'info' ? 'info' : 'success')) %>" role="status">
          <div><%- f.message %></div>
        </div>
      <% }); %>
    </div>
  <% } %>

  <main id="main"><%- body %></main>

  <%- include('../partials/footer') %>

  <script src="/js/app.js?v=14" defer></script>
  <script src="/js/marketplace.js?v=dealer-3" defer></script>
  <%- script %>
<div class="compare-tray" data-compare-tray hidden><div><strong data-compare-count>0 machines selected</strong><span data-compare-names></span></div><a href="/compare" class="btn btn-primary btn-inline" data-compare-link>Compare side by side ↗</a><button type="button" data-compare-clear aria-label="Clear comparison">Clear</button></div><p class="compare-feedback sr-only" aria-live="polite" data-compare-feedback></p><script src="/js/auction-room.js?v=1" defer></script><%- include('../partials/support-widget') %>
</body>
</html>
