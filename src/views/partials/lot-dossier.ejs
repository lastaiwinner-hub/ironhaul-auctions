<% const vehicle = brand.vertical === 'automotive'; const requestLink = topic => '/contact?subject=' + encodeURIComponent(topic + ': ' + listing.title + ' (stock ' + (listing.stock_number || listing.id) + ')'); %>
<section class="dossier-section dossier-record" id="records">
  <div class="dossier-heading"><span class="dossier-kicker"><%= vehicle ? 'THE VEHICLE FILE' : 'MACHINE DOCUMENTATION' %></span><h2><%= vehicle ? 'Know what you’re bidding on.' : 'The details behind the machine.' %></h2><p><%= vehicle ? 'Identity, ownership and condition information in one place.' : 'Service history, attachments and transport requirements for this lot.' %></p></div>
  <div class="record-grid">
    <article><span class="record-icon"><%- include('icons', { icon: 'clipboard' }) %></span><h3><%= vehicle ? 'Identity & title' : 'Identity & ownership' %></h3><dl><dt><%= vehicle ? 'VIN' : 'Serial number' %></dt><dd class="record-id"><%= (vehicle ? listing.vin : listing.serial_number) || 'Request from seller' %></dd><dt>Stock reference</dt><dd><%= listing.stock_number || 'Not supplied' %></dd><dt>Seller-listed title status</dt><dd><%= (vehicle ? listing.title_status : listing.lien_status) || 'Awaiting seller confirmation' %></dd></dl><a href="<%= requestLink('Title and ownership documents') %>">Request documents ↗</a></article>
    <article><span class="record-icon"><%- include('icons', { icon: 'clipboard' }) %></span><h3><%= vehicle ? 'History & condition' : 'Service & maintenance' %></h3><p><%= listing.service_notes || (vehicle ? 'A service-history report is not attached to this listing. Ask for maintenance invoices, accident-history information and any available inspection report.' : 'Service records have not been supplied for this listing. Request maintenance invoices and the most recent service details.') %></p><% if(listing.known_faults){ %><div class="record-note"><strong>Disclosed condition notes</strong><p><%= listing.known_faults %></p></div><% } else { %><div class="record-note"><strong>Before you bid</strong><p><%= vehicle ? 'Request close-up photos of paint, wheels, tyres and interior wear, plus a cold-start video.' : 'Request a cold-start video, close-ups of wear points and a demonstration under load.' %></p></div><% } %><a href="<%= requestLink(vehicle ? 'Vehicle history and condition report' : 'Service records and inspection report') %>">Ask for the full report ↗</a></article>
    <article><span class="record-icon"><%- include('icons', { icon: 'camera' }) %></span><h3><%= vehicle ? 'Equipment & handover' : 'Attachments & handover' %></h3><p><%= listing.included_items || (vehicle ? 'Confirm the number of keys, manuals, service book, accessories and any equipment included with the vehicle.' : 'Confirm the attachments, buckets, couplers, manuals and spare keys included in the sale.') %></p><div class="record-note"><strong><%= images.length %> catalogue photos available</strong><p>Catalogue images may be representative. Request current photos of this exact stock item before committing.</p></div><a href="<%= requestLink('Current photos and included items') %>">Confirm what’s included ↗</a></article>
  </div>
</section>
<section class="dossier-section" id="auction-guide">
  <div class="dossier-heading"><span class="dossier-kicker">BID WITH A PLAN</span><h2>Your auction, explained.</h2><p>The rules and costs for <%= listing.stock_number || listing.title %>.</p></div>
  <div class="auction-guide-grid">
    <div class="auction-rule-list">
      <div><span>01</span><div><h3>Choose your bid</h3><p>The opening bid is <strong><%= money.format(listing.starting_bid) %></strong>. Bids rise in <strong><%= money.format(listing.bid_increment) %></strong> increments. Check the bidding panel for the current minimum.</p></div></div>
      <div><span>02</span><div><h3>Set your ceiling</h3><p>Maximum bidding places bids for you only as needed, up to the amount you set. Your maximum is not displayed to other bidders.</p></div></div>
      <div><span>03</span><div><h3>Watch the closing time</h3><p>A bid placed in the final <%= brand.auction.antiSnipeWindowMin %> minutes resets the remaining time to <%= brand.auction.antiSnipeExtendMin %> minutes. The timer in the bidding panel shows the latest close.</p></div></div>
      <div><span>04</span><div><h3>Understand the reserve</h3><p><%= listing.reserve_price ? 'This lot has a reserve. A leading bid below the reserve does not secure the sale. Reserve status is shown with the current bid.' : 'No reserve is listed for this lot. Review the auction status and purchase terms before submitting a binding bid.' %></p></div></div>
    </div>
    <div class="purchase-breakdown"><span class="dossier-kicker">PURCHASE BREAKDOWN</span><h3>What to budget for</h3><dl><div><dt>Winning bid</dt><dd>Your final bid</dd></div><div><dt>Buyer’s premium</dt><dd><%= brand.terms.buyerPremiumPercent %>%</dd></div><div><dt>Delivery estimate</dt><dd>$<%= brand.terms.deliveryRatePerMile.toFixed(2) %> / mile</dd></div><div><dt>Taxes & registration</dt><dd>Confirm before bidding</dd></div><div><dt>Payment method</dt><dd><%= brand.terms.paymentMethods %></dd></div></dl><p>Delivery and any applicable taxes are additional to the sale price. Request an itemised quote for your destination.</p><a class="btn btn-ghost btn-inline" href="<%= requestLink('Itemised purchase and delivery quote') %>">Request a full quote ↗</a></div>
  </div>
</section>
<section class="dossier-section delivery-dossier" id="delivery-guide">
  <div class="dossier-heading"><span class="dossier-kicker"><%= vehicle ? 'FROM THE AUCTION TO YOUR DRIVEWAY' : 'FROM OUR YARD TO YOUR JOBSITE' %></span><h2><%= vehicle ? 'Plan your vehicle’s next journey.' : 'Get delivery ready.' %></h2><p>Dispatch location: <strong><%= [listing.location_city, listing.location_state].filter(Boolean).join(', ') || 'To be confirmed' %> <%= listing.location_zip %></strong></p></div>
  <div class="delivery-facts"><div><span>Delivery estimate</span><strong><%= brand.terms.deliveryWindow %></strong><small>Confirm scheduling with the team</small></div><div><span>Inspection window</span><strong><%= brand.terms.inspectionDays %> days</strong><small>After delivery, subject to purchase terms</small></div><div><span>Warranty period</span><strong><%= brand.terms.warrantyMonths %> months</strong><small>Request coverage and exclusions</small></div></div>
  <div class="delivery-checklist"><div><h3>Before dispatch</h3><ul><li>Confirm the delivery address, access restrictions and an on-site contact.</li><li><%= vehicle ? 'Agree open or enclosed transport, vehicle clearance and collection arrangements.' : 'Confirm trailer suitability, unloading equipment, ground conditions and site access.' %></li><li>Request the final invoice, ownership documents and delivery schedule.</li></ul></div><div><h3>At handover</h3><ul><li>Match the <%= vehicle ? 'VIN' : 'serial number' %> and stock reference to your agreement.</li><li>Photograph the condition and check all agreed accessories are present.</li><li>Record any concerns and contact the team within the purchase terms’ notice period.</li></ul></div></div>
</section>
<section class="dossier-section lot-questions" id="lot-questions">
  <div class="dossier-heading"><span class="dossier-kicker">BEFORE YOU PLACE YOUR BID</span><h2>A few things worth knowing.</h2></div>
  <details open><summary>Can I get a closer look before bidding?</summary><p>Yes—contact the team with stock reference <strong><%= listing.stock_number || listing.id %></strong> to request current photos, a walkthrough or inspection arrangements. Confirm availability before travelling.</p><a href="<%= requestLink('Pre-bid inspection and walkthrough') %>">Arrange a closer look ↗</a></details>
  <details><summary>What should I check in the <%= vehicle ? 'vehicle history' : 'maintenance history' %>?</summary><p><%= vehicle ? 'Ask for dated service invoices, mileage records, ownership and title documents, any accident or repair disclosures, and the most recent inspection. A title status alone does not establish a vehicle’s full history.' : 'Ask for dated service invoices, hour-meter records, hydraulic and engine maintenance, undercarriage or tyre work, and any structural repairs. Compare those records with the serial number and disclosed condition notes.' %></p></details>
  <details><summary>What does the inspection period include?</summary><p>The listed inspection window is <%= brand.terms.inspectionDays %> days after delivery, with an allowance of <%= vehicle ? brand.terms.maxInspectionMiles + ' road miles' : brand.terms.maxInspectionHours + ' operating hours' %>. Review the signed purchase agreement for eligibility, return notice requirements and exclusions before purchasing.</p><a href="/terms-of-service">Read purchase terms ↗</a></details>
  <details><summary>Can I buy this lot without waiting for the auction?</summary><p>The listed Buy Now price is <strong><%= money.format(listing.buy_now_price) %></strong>. Use the Buy Now option in the bidding panel to review the purchase steps. Availability and the final purchase terms apply.</p></details>
  <details><summary>What happens after the auction?</summary><p>Check your account for the result and purchase agreement. Confirm payment instructions, documents and delivery arrangements with <%= brand.shortName %>. Review all amounts and terms before completing payment.</p><a href="/how-it-works">See the buying process ↗</a></details>
  <div class="dossier-contact"><div><h3>Still have a question about this <%= vehicle ? 'vehicle' : 'machine' %>?</h3><p>Ask about stock <%= listing.stock_number || listing.id %>. <%= brand.contact.hours %>.</p></div><a class="btn btn-primary btn-inline" href="<%= requestLink('Question about this lot') %>">Ask the team ↗</a></div>
</section>
