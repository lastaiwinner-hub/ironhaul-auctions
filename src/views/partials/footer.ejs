<section class="cta-band">
  <div class="wrap">
    <div>
      <div class="eyebrow" style="color:rgba(255,255,255,.78)">Ready when you are</div>
      <h2 class="h2" style="margin-top:8px"><%= liveCount %> machines on the block right now.</h2>
      <p style="margin-top:8px;max-width:52ch;opacity:.85">Register free, verify once, and bid or buy outright — with delivery anywhere in <%= brand.terms.deliveryRegion %>.</p>
    </div>
    <div class="row" style="gap:10px">
      <a href="/inventory" class="btn btn-dark btn-lg btn-inline">Browse inventory</a>
      <% if (!currentUser) { %>
        <a href="/register" class="btn btn-outline-light btn-lg btn-inline">Create account</a>
      <% } %>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="wrap">
    <div class="footer-grid">
      <div>
        <a href="/" class="logo" style="margin-bottom:16px">
          <span class="logo-mark"><%- include('./icons', { icon: 'excavator', strokeWidth: 1.8 }) %></span>
          <span class="logo-text">
            <span class="logo-name" style="color:#fff"><%= brand.shortName %></span>
            <span class="logo-sub" style="color:var(--accent-light)"><%= brand.name.replace(brand.shortName, '').trim() || 'Auctions' %></span>
          </span>
        </a>
        <p class="small" style="max-width:38ch;line-height:1.65">
          <%= brand.legalName %> — heavy equipment auctions and instant-buy pricing, run out of
          <%= brand.address.city %>, <%= brand.address.stateFull %>, with verified bidders and
          digital purchase agreements.
        </p>
        <div class="row small" style="gap:8px;margin-top:18px;color:rgba(255,255,255,.55)">
          <%- include('./icons', { icon: 'shield', iconClass: '', strokeWidth: 1.6 }) %>
          <span>Identity-verified bidding · No buyer premium</span>
        </div>
      </div>

      <div>
        <h4>Navigate</h4>
        <ul class="footer-links">
          <li><a href="/inventory">All equipment</a></li>
          <li><a href="/inventory?filter=auction">Live auctions</a></li>
          <li><a href="/how-it-works">How to buy</a></li>
          <li><a href="/about">About us</a></li>
          <li><a href="/reviews">Buyer reviews</a></li>
          <li><a href="/contact">Contact us</a></li>
          <% if (currentUser) { %>
            <li><a href="/account">My account</a></li>
          <% } else { %>
            <li><a href="/register">Create an account</a></li>
          <% } %>
        </ul>
      </div>

      <div>
        <h4>Policies</h4>
        <ul class="footer-links">
          <li><a href="/terms-of-service">Terms &amp; conditions</a></li>
          <li><a href="/privacy-policy">Privacy policy</a></li>
          <li><a href="/faq#payment">Payment &amp; delivery</a></li>
          <li><a href="/faq#returns"><%= brand.terms.inspectionDays %>-day inspection</a></li>
          <li><a href="/faq">Frequently asked questions</a></li>
        </ul>
      </div>

      <div>
        <h4>Contact</h4>
        <ul class="footer-links">
          <li style="color:rgba(255,255,255,.5);font-size:.72rem;letter-spacing:.1em;text-transform:uppercase">Address</li>
          <li style="font-size:.86rem">
            <%= brand.address.line1 %><br>
            <%= brand.address.city %>, <%= brand.address.state %> <%= brand.address.postalCode %>
          </li>
          <li style="color:rgba(255,255,255,.5);font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;margin-top:12px">Phone</li>
          <li><a href="tel:<%= brand.contact.phoneHref %>"><%= brand.contact.phone %></a></li>
          <li style="color:rgba(255,255,255,.5);font-size:.72rem;letter-spacing:.1em;text-transform:uppercase;margin-top:12px">Email</li>
          <li><a href="mailto:<%= brand.contact.email %>"><%= brand.contact.email %></a></li>
          <li style="color:rgba(255,255,255,.5);font-size:.82rem;margin-top:12px"><%= brand.contact.hours %></li>
        </ul>
      </div>
    </div>

    <div class="footer-bottom">
      <div>&copy; <%= new Date().getFullYear() %> <%= brand.legalName %>. All rights reserved.</div>
      <div class="row" style="gap:18px">
        <a href="/terms-of-service">Terms of Service</a>
        <a href="/privacy-policy">Privacy Policy</a>
        <a href="/faq">FAQ</a>
      </div>
    </div>
  </div>
</footer>
