<% const end=lot.auction_ends_at?dates.countdown(lot.auction_ends_at):null; const open=lot.status==='live'&&end&&!end.ended; %>
<article class="spotlight-card" data-auction="<%= lot.slug %>"><a class="spotlight-image" href="/lot/<%= lot.slug %>"><% if(lot.primary_image){ %><img src="/uploads/listings/<%= lot.primary_image %>" alt="<%= lot.title %> — catalogue photograph" width="680" height="510" loading="eager"><% }else{ %><span class="image-placeholder"><%- include('./icons',{icon:'excavator'}) %></span><% } %><span class="spotlight-badge"><span data-auction-status><%= open?'OPEN FOR BIDDING':'FEATURED INVENTORY' %></span></span></a><div class="spotlight-body"><span class="spotlight-category"><%= lot.category_name %></span><h2><a href="/lot/<%= lot.slug %>"><%= lot.title %></a></h2><div class="spotlight-spec"><span><%= lot.year %></span><span><%= lot.hours == null ? "—" : Number(lot.hours).toLocaleString("en-US") %> hours</span></div><div class="spotlight-price"><div><span data-auction-price-caption><%= lot.bid_count?'Current bid':'Opening bid' %></span><strong data-auction-price><%= money.formatShort(lot.current_bid||lot.starting_bid) %></strong></div><span class="spotlight-bids"><b data-auction-bids><%= lot.bid_count||0 %></b> bids</span></div><a href="/lot/<%= lot.slug %>#bidding" class="spotlight-link" data-auction-link><%= open?'Explore auction':'View listing' %><span>→</span></a></div><% if(end){ %><div class="spotlight-timer" data-countdown="<%= lot.auction_ends_at %>"><%- include('./icons',{icon:'clock'}) %><span data-countdown-label><%= end.label %></span></div><% } %></article>