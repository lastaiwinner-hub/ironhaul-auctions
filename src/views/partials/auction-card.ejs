<% const cardCd=lot.auction_ends_at?dates.countdown(lot.auction_ends_at):null; const cardLive=lot.status==='live'&&cardCd&&!cardCd.ended; %>
<article class="auction-card cell" data-auction="<%= lot.slug %>" data-auction-card data-reserve="<%= lot.reserve_price ? 'yes' : 'no' %>" data-bid-total="<%= lot.bid_count || 0 %>" data-end-time="<%= lot.auction_ends_at || '' %>">
 <div class="auction-card-image"><a href="/lot/<%= lot.slug %>" aria-label="View <%= lot.title %>"><% if(lot.primary_image) { %><img src="/uploads/listings/<%= lot.primary_image %>" alt="<%= lot.title %> — catalogue photograph" width="720" height="540" loading="lazy"><% } else { %><span class="image-placeholder"><%- include('./icons',{icon:'excavator'}) %></span><% } %></a><span class="auction-state" data-auction-status><span class="live-dot"></span><%= cardLive ? 'Live auction' : lot.status === 'sold' ? 'Sold' : 'View listing' %></span><% if(currentUser) { %><form method="post" action="/lot/<%= lot.slug %>/watch" class="save-auction"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" aria-label="Toggle watchlist for <%= lot.title %>"><%- include('./icons',{icon:'heart'}) %></button></form><% } else { %><a href="/login" class="save-auction" aria-label="Sign in to save <%= lot.title %>"><%- include('./icons',{icon:'heart'}) %></a><% } %><% if(cardCd) { %><div class="auction-countdown" data-countdown="<%= lot.auction_ends_at %>"><%- include('./icons',{icon:'clock'}) %><span data-countdown-label><%= cardCd.label %></span></div><% } %></div>
 <div class="auction-card-body"><div class="auction-meta"><%= lot.category_name || 'equipment' %><% if(!lot.reserve_price) { %><span>No reserve</span><% } %></div><h3><a href="/lot/<%= lot.slug %>"><%= lot.title %></a></h3><div class="auction-specs"><span><%= lot.hours == null ? "Hours not listed" : Number(lot.hours).toLocaleString("en-US") + " hrs" %></span><span><%= lot.engine_hp ? lot.engine_hp + " HP" : lot.make %></span><span><%= lot.inspection_grade ? Number(lot.inspection_grade).toFixed(1) + "/5 grade" : lot.year %></span></div><div class="auction-price-row"><div><span class="price-caption" data-auction-price-caption><%= lot.bid_count ? 'Current bid' : 'Opening bid' %></span><strong data-auction-price><%= money.formatShort(lot.current_bid || lot.starting_bid) %></strong></div><span class="bid-total"><%- include('./icons',{icon:'gavel'}) %><span data-auction-bids><%= lot.bid_count || 0 %></span> bids</span></div><a class="action action-bid" data-auction-link href="/lot/<%= lot.slug %>#bidding"><%= cardLive ? 'View & bid' : 'View listing' %><span aria-hidden="true">↗</span></a><div class="buy-outright"><span>Prefer not to wait?</span><a href="/lot/<%= lot.slug %>/buy">Buy now <%= money.formatShort(lot.buy_now_price) %></a></div></div>
<%- include('./compare-button', {lot}) %>
</article>