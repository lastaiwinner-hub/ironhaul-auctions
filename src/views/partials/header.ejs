<div class="utility-bar"><div class="wrap"><span>ONLINE AUCTIONS. REAL OPPORTUNITY.</span><div><a href="/how-it-works">First time bidding?</a><a href="/contact">Talk to our team <span aria-hidden="true">↗</span></a></div></div></div>
<header class="site-header"><div class="wrap site-header-row">
<a href="/" class="brand-lockup" aria-label="<%= brand.name %> home"><span class="brand-symbol"><%- include('./brand-mark') %></span><span class="brand-word"><%= brand.shortName %><span>AUCTIONS</span></span></a>
<nav class="main-nav" id="site-nav" aria-label="Main navigation"><a href="/inventory?filter=auction" class="<%= query.filter === 'auction' ? 'selected' : '' %>"><span class="live-dot"></span> Live auctions</a><a href="/inventory" class="<%= isActive('/inventory') && query.filter !== 'auction' ? 'selected' : '' %>">Browse inventory</a><a href="/how-it-works">How it works</a><a href="/about">Our story</a><div class="mobile-account"><a href="<%= currentUser ? '/account' : '/login' %>"><%= currentUser ? 'My account' : 'Sign in' %></a><% if (!currentUser) { %><a href="/register">Create account</a><% } %></div></nav>
<div class="site-account"><a class="account-link" href="<%= currentUser ? '/account' : '/login' %>"><%- include('./icons',{icon:'user'}) %><%= currentUser ? 'My account' : 'Sign in' %></a><a class="action action-accent" href="<%= currentUser ? '/account/watchlist' : '/register' %>"><%= currentUser ? 'My watchlist' : 'Register to bid' %><span aria-hidden="true">↗</span></a></div>
<button type="button" class="menu-button" data-nav-toggle aria-expanded="false" aria-controls="site-nav" aria-label="Open navigation"><%- include('./icons',{icon:'menu'}) %></button>
</div></header>