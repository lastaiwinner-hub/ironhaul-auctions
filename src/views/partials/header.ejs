<header class="site-header dealer-header">
 <div class="wrap dealer-masthead">
  <a href="/" class="brand-lockup" aria-label="<%= brand.name %> home"><span class="dealer-brand-icon"><img src="/img/ironlot-symbol.svg" alt="" width="64" height="64"></span><span class="brand-word"><%= brand.shortName %><span>EQUIPMENT SALES & AUCTIONS</span></span></a>
  <div class="dealer-hours"><%- include('./icons',{icon:'clock'}) %><div><span>HERE WHEN YOU NEED US</span><strong><%= brand.contact.hoursShort %></strong></div></div>
  <a class="dealer-phone" href="tel:<%= brand.contact.phoneHref %>"><span class="phone-symbol"><%- include('./icons',{icon:'phone'}) %></span><span><small>TALK TO THE EQUIPMENT TEAM</small><strong><%= brand.contact.phone %></strong></span></a>
  <a href="<%= currentUser ? '/account' : '/login' %>" class="dealer-account"><%- include('./icons',{icon:'user'}) %><span><%= currentUser ? 'My account' : 'Sign in' %></span></a>
  <button type="button" class="menu-button" data-nav-toggle aria-expanded="false" aria-controls="site-nav" aria-label="Open navigation"><%- include('./icons',{icon:'menu'}) %></button>
 </div>
 <div class="dealer-navband"><div class="wrap dealer-navrow"><nav class="main-nav" id="site-nav" aria-label="Main navigation"><a href="/" class="<%= currentPath==='/' ? 'selected' : '' %>">Home</a><a href="/inventory" class="<%= isActive('/inventory') ? 'selected' : '' %>">Browse equipment</a><a href="/inventory?filter=auction">Live auctions <span class="nav-count"><%= auctionCount %></span></a><a href="/how-it-works">How to buy</a><a href="/about">About us</a><a href="/faq">FAQ</a><a href="/contact">Contact</a><div class="mobile-account"><a href="<%= currentUser ? '/account' : '/login' %>"><%= currentUser ? 'My account' : 'Sign in' %></a><a href="/register">Register to bid</a></div></nav><span class="mobile-auction-summary"><span class="live-dot"></span><%= auctionCount %> auctions open</span><a class="dealer-register" href="<%= currentUser ? '/account/watchlist' : '/register' %>"><%= currentUser ? 'My watchlist' : 'Register to bid' %><span aria-hidden="true">↗</span></a></div></div>
</header>