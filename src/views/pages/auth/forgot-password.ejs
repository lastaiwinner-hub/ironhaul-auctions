<section class="section">
  <div class="wrap wrap-tight">
    <div class="card card-pad">
      <% if (sent) { %>
        <div class="center">
          <div style="width:56px;height:56px;margin:0 auto 18px;border-radius:50%;display:grid;place-items:center;background:#EDF7F1;color:var(--success)">
            <%- include('../../partials/icons', { icon: 'mail', strokeWidth: 1.8 }) %>
          </div>
          <h1 class="h2 mb-2">Check your inbox</h1>
          <p class="muted" style="max-width:44ch;margin-inline:auto;line-height:1.7">
            If an account exists for <strong><%= values.email %></strong>, we have sent a
            link to reset your password. It expires in
            <%= brand.terms.currency ? '' : '' %>a couple of hours and can be used once.
          </p>
          <p class="small muted mt-3">
            Nothing arrived? Check your spam folder, or
            <a href="/forgot-password" style="color:var(--accent-ink);font-weight:700">try again</a>.
          </p>
          <a href="/login" class="btn btn-ghost mt-4 btn-inline">Back to sign in</a>
        </div>
      <% } else { %>
        <div class="eyebrow">Account recovery</div>
        <h1 class="h2" style="margin:8px 0 8px">Reset your password</h1>
        <p class="muted small mb-4">
          Enter the email address on your account and we will send you a reset link.
        </p>

        <form method="post" action="/forgot-password" novalidate>
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="field">
            <label class="label" for="email">Email address</label>
            <input class="input <%= errors.email ? 'input-error' : '' %>" type="email" id="email"
                   name="email" value="<%= values.email || '' %>" autocomplete="email" autofocus required>
            <% if (errors.email) { %><div class="error-text"><%= errors.email %></div><% } %>
          </div>

          <button type="submit" class="btn btn-primary btn-lg btn-block">Send reset link</button>
        </form>

        <p class="center small muted mt-3">
          Remembered it? <a href="/login" style="color:var(--accent-ink);font-weight:700">Sign in</a>
        </p>
      <% } %>
    </div>
  </div>
</section>
