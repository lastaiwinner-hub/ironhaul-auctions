<section class="pagehead">
  <div class="wrap">
    <nav class="crumbs"><a href="/">Home</a><span class="sep">›</span><span class="current">About</span></nav>
    <div class="eyebrow">Who we are</div>
    <h1 class="h1" style="margin-top:8px">About<br><%= brand.name %>.</h1>
    <p class="lede">
      An equipment auction house run out of <%= brand.address.city %>,
      <%= brand.address.stateFull %> — built on straight talk, honest hour
      readings and paperwork that does not drag.
    </p>
  </div>
</section>

<section class="section">
  <div class="wrap wrap-narrow">
    <div class="card card-pad">
      <div class="eyebrow">Our story</div>
      <h2 class="h2" style="margin:10px 0 16px"><%= brand.address.city %>, <%= brand.address.state %>.<br>Built to last.</h2>
      <p style="line-height:1.75">
        We started <%= brand.legalName %> on a simple principle: buyers deserve honest
        information, professional service and machines they can count on. Everything we
        list comes through our own yard, gets inspected and serviced, and is photographed
        as it actually sits — hours, wear, faults and all.
      </p>
      <p style="line-height:1.75;margin-top:14px">
        We run auctions because they price a machine fairly, and we keep a Buy Now number
        on every lot because sometimes you just need the thing on site by Friday. Either
        way, the number you agree is the number you pay. No buyer premium, no listing fee,
        no line item that appears at the end.
      </p>
      <p style="line-height:1.75;margin-top:14px">
        Every bidder is identity-verified before their first bid. That keeps the bidding
        honest for the people who are serious, and it means the winning bid is a real
        commitment rather than a number typed by an anonymous account.
      </p>
      <div class="row mt-4">
        <a href="/inventory" class="btn btn-primary btn-inline">Browse inventory</a>
        <a href="/contact" class="btn btn-ghost btn-inline">Contact us</a>
      </div>
    </div>
  </div>
</section>

<section class="section section-alt">
  <div class="wrap">
    <div class="center mb-4">
      <div class="eyebrow">Our values</div>
      <h2 class="h2" style="margin-top:8px">What we stand for</h2>
    </div>
    <div class="grid grid-3">
      <% values.forEach(function (v) { %>
        <div class="value-card">
          <h3 class="h4"><%= v.title %></h3>
          <p class="small muted" style="line-height:1.7"><%= v.body %></p>
        </div>
      <% }); %>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="row-between mb-4">
      <div>
        <div class="eyebrow">Verified buyers</div>
        <h2 class="h2" style="margin-top:8px">What buyers say about us</h2>
      </div>
      <a href="/reviews" class="btn btn-ghost btn-inline">All reviews</a>
    </div>
    <div class="grid grid-3">
      <% reviews.slice(0, 3).forEach(function (r) { %>
        <div class="review-card">
          <div class="stars">
            <% for (let i = 0; i < r.rating; i++) { %><%- include('../partials/icons', { icon: 'star', strokeWidth: 0 }) %><% } %>
          </div>
          <p class="review-body">&ldquo;<%= r.body %>&rdquo;</p>
          <div class="review-who">
            <%- include('../partials/avatar', { person: r }) %>
            <div>
              <div class="small" style="font-weight:700"><%= r.name %></div>
              <div class="xsmall muted"><%= r.location %></div>
            </div>
          </div>
        </div>
      <% }); %>
    </div>
  </div>
</section>
