<%
const hasBids = listing.bid_count > 0;
const live = listing.status === 'live' && countdown && !countdown.ended;
const nextSteps = [minimum, minimum + listing.bid_increment, minimum + listing.bid_increment * 2];
%>

<section class="pagehead">
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a><span class="sep">›</span>
      <a href="/inventory">Inventory</a><span class="sep">›</span>
      <% if (listing.category_slug) { %>
        <a href="/inventory?category=<%= listing.category_slug %>"><%= listing.category_name %></a>
        <span class="sep">›</span>
      <% } %>
      <span class="current"><%= listing.title %></span>
    </nav>

    <div class="row-between">
      <div>
        <div class="row" style="gap:8px;margin-bottom:10px">
          <% if (live) { %>
            <span class="badge badge-live"><span class="dot dot-pulse"></span> Live auction</span>
          <% } else if (listing.status === 'sold') { %>
            <span class="badge badge-dark">Sold</span>
          <% } else { %>
            <span class="badge badge-muted">Buy now available</span>
          <% } %>
          <% if (listing.is_featured) { %><span class="badge badge-accent">Featured</span><% } %>
          <% if (cycle) { %><span class="badge badge-info">Cycle #<%= cycle.cycle_number %></span><% } %>
          <% if (band !== 'none') { %>
            <span class="badge badge-<%= band === 'good' ? 'success' : (band === 'fair' ? 'warn' : 'muted') %>">
              Grade <%= Number(listing.inspection_grade).toFixed(1) %> / 5
            </span>
          <% } %>
        </div>
        <h1 class="h1" style="max-width:22ch"><%= listing.title %></h1>
        <p class="small mono" style="color:rgba(17,19,24,.66);margin-top:10px">
          <% if (listing.lot_number) { %>Lot <%= String(listing.lot_number).padStart(2, '0') %> · <% } %>
          Stock <%= listing.stock_number || '—' %> ·
          Serial <%= listing.serial_number || 'On request' %> ·
          <%= listing.location_city %>, <%= listing.location_state %> ·
          <%= images.length %> photo<%= images.length === 1 ? '' : 's' %> ·
          <%= listing.view_count %> views
        </p>
      </div>

      <div style="text-align:right">
        <div class="xsmall mono" style="color:rgba(17,19,24,.62);letter-spacing:.14em;text-transform:uppercase;font-weight:600">Buy now price</div>
        <div style="font-family:var(--font-display);font-size:clamp(2rem,4vw,2.8rem);font-weight:700;color:var(--ink);line-height:1.05">
          <%= money.formatShort(listing.buy_now_price) %>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="lot-layout">
      <!-- Gallery + details -->
      <div>
        <div data-gallery>
          <div class="gallery-main">
            <% if (images.length) { %>
              <img src="/uploads/listings/<%= images[0].file_name %>"
                   alt="<%= images[0].alt || listing.title %>"
                   data-gallery-main width="1000" height="750">
              <% if (images.length > 1) { %>
                <button type="button" class="gallery-nav gallery-prev" data-gallery-prev aria-label="Previous photo">
                  <%- include('../partials/icons', { icon: 'chevronL', strokeWidth: 2.2 }) %>
                </button>
                <button type="button" class="gallery-nav gallery-next" data-gallery-next aria-label="Next photo">
                  <%- include('../partials/icons', { icon: 'chevronR', strokeWidth: 2.2 }) %>
                </button>
              <% } %>
              <span class="gallery-count" data-gallery-count>1 / <%= images.length %></span>
            <% } else { %>
              <div style="display:grid;place-items:center;height:100%;color:var(--muted);opacity:.35">
                <%- include('../partials/icons', { icon: 'excavator', iconClass: '', strokeWidth: 1 }) %>
              </div>
            <% } %>
          </div>

          <% if (images.length > 1) { %>
            <div class="thumbs">
              <% images.forEach(function (img, i) { %>
                <button type="button" class="thumb <%= i === 0 ? 'is-active' : '' %>"
                        data-gallery-thumb
                        data-src="/uploads/listings/<%= img.file_name %>"
                        data-alt="<%= img.alt || listing.title %>"
                        aria-label="Photo <%= i + 1 %>">
                  <img src="/uploads/listings/<%= img.file_name %>" alt="" loading="lazy" width="160" height="120">
                </button>
              <% }); %>
            </div>
          <% } %>
        </div>

        <div class="row mt-2" style="gap:9px">
          <button type="button" class="btn btn-dark btn-inline" data-video-open>
            <%- include('../partials/icons', { icon: 'camera', strokeWidth: 1.9 }) %>
            See walkthrough video
          </button>
          <a href="/contact?subject=<%= encodeURIComponent('Photo request: ' + listing.title) %>"
             class="btn btn-ghost btn-inline">Request more photos</a>
          <% if (listing.quantity > 1) { %>
            <span class="tag tag-blue"><%= listing.quantity %> in stock — we keep selling after each cycle</span>
          <% } %>
        </div>

        <div class="promise-strip mt-3">
          <div>
            <div class="n"><%= brand.terms.inspectionDays %></div>
            <div class="l">Day inspection</div>
          </div>
          <div>
            <div class="n">US</div>
            <div class="l">Nationwide delivery</div>
          </div>
          <div>
            <div class="n"><%= brand.terms.warrantyMonths %></div>
            <div class="l">Month warranty</div>
          </div>
          <div>
            <div class="n">0%</div>
            <div class="l">Buyer premium</div>
          </div>
        </div>

        <!-- The reference site keeps a video slot on every listing even when the
             walkthrough has not been filmed yet; buyers ask for it by name. -->
        <dialog class="modal" data-video-dialog>
          <div class="modal-head">
            <div>
              <h2 class="h3">Equipment video</h2>
              <div class="mono xsmall muted" style="margin-top:4px"><%= listing.title.toUpperCase() %></div>
            </div>
            <button type="button" class="modal-close" data-video-close aria-label="Close">×</button>
          </div>
          <div class="modal-body center">
            <h3 class="h4">No video yet</h3>
            <p class="small muted mt-1" style="max-width:44ch;margin-inline:auto">
              Ask us and we will film a walkthrough of this machine — cold start,
              full function test and a close look at anything in the report.
            </p>
            <a href="/contact?subject=<%= encodeURIComponent('Video request: ' + listing.title) %>"
               class="btn btn-primary mt-3 btn-inline">Request a walkthrough</a>
          </div>
        </dialog>

        <!-- ---- Condition report ---------------------------------------- -->
        <h2 class="h3 mt-5 mb-2" id="condition">Condition report</h2>
        <div class="card card-pad">
          <div class="cond-summary">
            <div>
              <% if (band !== 'none') { %>
                <div class="grade-big grade-<%= band %>"><%= Number(listing.inspection_grade).toFixed(1) %><span>/5</span></div>
              <% } else { %>
                <div class="grade-big grade-none">—</div>
              <% } %>
              <div class="lab" style="margin-top:8px">Overall grade</div>
            </div>
            <div class="cond-summary-meta">
              <dl class="facts">
                <% if (listing.inspected_at) { %>
                  <dt>Inspected</dt>
                  <dd><%= dates.formatLong(listing.inspected_at) %><% if (listing.inspected_by) { %> by <%= listing.inspected_by %><% } %></dd>
                <% } %>
                <dt>Title</dt><dd><%= listing.lien_status || 'Title clear, no liens' %></dd>
                <dt>Serial</dt><dd class="mono"><%= listing.serial_number || 'On request' %></dd>
              </dl>
            </div>
          </div>

          <% if (listing.condition_scores && listing.condition_scores.length) { %>
            <div class="bars" style="margin-top:18px">
              <% listing.condition_scores.forEach(function (sc) { %>
                <div class="bar">
                  <span class="n"><%= sc.label %></span>
                  <span class="track"><span class="fill fill-<%= wearBand(sc.pct) %>" style="width:<%= Math.max(0, Math.min(100, Number(sc.pct))) %>%"></span></span>
                  <span class="p"><%= Number(sc.pct) %>%</span>
                </div>
              <% }); %>
            </div>
            <p class="xsmall muted" style="margin-top:10px">
              Percentages are remaining service life measured at inspection, not a
              subjective rating. Anything under 60% is called out in the notes below.
            </p>
          <% } %>

          <dl class="facts" style="margin-top:18px">
            <% if (listing.included_items) { %><dt>Included</dt><dd><%= listing.included_items %></dd><% } %>
            <% if (listing.service_notes) { %><dt>Serviced</dt><dd><%= listing.service_notes %></dd><% } %>
            <% if (listing.known_faults) { %><dt>Known faults</dt><dd class="flag"><%= listing.known_faults %></dd><% } %>
          </dl>

          <% if (listing.transport_length) { %>
            <h3 class="lab" style="margin-top:20px;margin-bottom:8px">Transport dimensions</h3>
            <table class="spec-table">
              <tbody>
                <tr><th>Shipping length</th><td><%= listing.transport_length %></td></tr>
                <tr><th>Shipping width</th><td><%= listing.transport_width %></td></tr>
                <tr><th>Shipping height</th><td><%= listing.transport_height %></td></tr>
                <% if (listing.operating_weight) { %>
                  <tr><th>Weight</th><td><%= Number(listing.operating_weight).toLocaleString('en-US') %> lbs</td></tr>
                <% } %>
                <tr><th>Carrier</th><td><%= listing.requires_permit ? 'Lowboy required · oversize permit needed' : 'Standard step-deck, no permit required' %></td></tr>
              </tbody>
            </table>
          <% } %>
        </div>

        <!-- Specifications -->
        <h2 class="h3 mt-5 mb-2">Specifications</h2>
        <table class="spec-table">
          <tbody>
            <tr><th>Year</th><td><%= listing.year || '—' %></td></tr>
            <tr><th>Manufacturer</th><td><%= listing.make || '—' %></td></tr>
            <tr><th>Model</th><td><%= listing.model || '—' %></td></tr>
            <tr><th>Hour meter</th><td><%= meterLabel %></td></tr>
            <% if (listing.engine_hp) { %><tr><th>Engine HP</th><td><%= listing.engine_hp %> HP</td></tr><% } %>
            <% if (listing.engine_type) { %><tr><th>Engine</th><td><%= listing.engine_type %></td></tr><% } %>
            <% if (listing.operating_weight) { %><tr><th>Operating weight</th><td><%= Number(listing.operating_weight).toLocaleString('en-US') %> lbs</td></tr><% } %>
            <% if (listing.fuel_type) { %><tr><th>Fuel</th><td><%= listing.fuel_type %></td></tr><% } %>
            <tr><th>Serial number</th><td><%= listing.serial_number || 'On request' %></td></tr>
            <tr><th>Condition</th><td style="text-transform:capitalize"><%= listing.condition %></td></tr>
            <tr><th>Stock number</th><td><%= listing.stock_number || '—' %></td></tr>
            <tr><th>Location</th><td><%= listing.location_city %>, <%= listing.location_state %> <%= listing.location_zip %></td></tr>
            <tr><th>Category</th><td><%= listing.category_name || '—' %></td></tr>
          </tbody>
        </table>

        <% if (listing.specs && listing.specs.length) { %>
          <% listing.specs.forEach(function (group) { %>
            <h3 class="h4 mt-4 mb-2"><%= group.group %></h3>
            <table class="spec-table">
              <tbody>
                <% (group.items || []).forEach(function (item) { %>
                  <tr><th><%= item.label %></th><td><%= item.value %></td></tr>
                <% }); %>
              </tbody>
            </table>
          <% }); %>
        <% } %>

        <!-- Overview -->
        <% if (listing.description) { %>
          <h2 class="h3 mt-5 mb-2">Machine overview</h2>
          <div class="card card-pad">
            <p style="line-height:1.75;white-space:pre-line"><%= listing.description %></p>

            <% if (listing.highlights && listing.highlights.length) { %>
              <ul class="stack mt-3" style="--stack-gap:10px">
                <% listing.highlights.forEach(function (h) { %>
                  <li class="row" style="gap:10px;align-items:flex-start;flex-wrap:nowrap">
                    <span style="color:var(--success);flex:none;margin-top:3px">
                      <%- include('../partials/icons', { icon: 'check', strokeWidth: 2.4 }) %>
                    </span>
                    <span class="small"><%= h %></span>
                  </li>
                <% }); %>
              </ul>
            <% } %>

            <div class="alert alert-warning mt-3">
              <div>
                <strong>Every purchase includes a <%= brand.terms.inspectionDays %>-day inspection period after delivery.</strong>
                If the machine does not match its description we arrange collection at our
                cost and refund you in full within <%= brand.terms.refundWindowHours %> hours.
                A <%= brand.terms.warrantyMonths %>-month warranty follows the inspection window.
              </div>
            </div>
          </div>
        <% } %>

        <!-- Bid history -->
        <h2 class="h3 mt-5 mb-2" id="history">Bid history</h2>
        <div class="card card-pad">
          <% if (history.length) { %>
            <div class="bid-history" data-live-history>
              <% history.forEach(function (b) { %>
                <div class="bid-row <%= currentUser && b.user_id === currentUser.id ? 'is-you' : '' %>">
                  <div>
                    <div class="small" style="font-weight:600">
                      <%= maskBidder(b) %>
                      <% if (currentUser && b.user_id === currentUser.id) { %>
                        <span class="badge badge-accent" style="margin-left:6px">You</span>
                      <% } %>
                      <% if (b.is_auto) { %>
                        <span class="badge badge-muted" style="margin-left:6px">Auto</span>
                      <% } %>
                    </div>
                    <div class="xsmall muted"><%= dates.relative(b.created_at) %></div>
                  </div>
                  <div class="amt mono"><%= money.format(b.amount) %></div>
                </div>
              <% }); %>
            </div>
          <% } else { %>
            <p class="muted small">No bids yet on this cycle — the opening bid is <%= money.format(listing.starting_bid) %>.</p>
          <% } %>

          <% if (previousCycles.length) { %>
            <details class="mt-3">
              <summary class="small" style="cursor:pointer;font-weight:600">Previous auction cycles (<%= previousCycles.length %>)</summary>
              <div class="mt-2">
                <% previousCycles.forEach(function (c) { %>
                  <div class="bid-row">
                    <div>
                      <div class="small" style="font-weight:600">Cycle #<%= c.cycle_number %></div>
                      <div class="xsmall muted">
                        Closed <%= dates.formatDateTime(c.closed_at) %>
                        <%= c.winning_user_id ? '· won' : '· no sale' %>
                      </div>
                    </div>
                    <div class="amt mono"><%= c.final_amount ? money.format(c.final_amount) : '—' %></div>
                  </div>
                <% }); %>
              </div>
              <p class="xsmall muted mt-2">
                We hold stock, so a machine stays on sale after a cycle is won —
                each cycle above concluded with its own buyer.
              </p>
            </details>
          <% } %>
        </div>
      </div>

      <!-- Bidding panel -->
      <aside>
        <div class="bidbox" id="bidding" data-live-lot="<%= listing.slug %>">
          <div class="bidbox-head">
            <div class="row-between" style="align-items:flex-start">
              <div>
                <div class="bid-label"><%= hasBids ? 'Current bid' : 'Opening bid' %></div>
                <div class="bid-amount mono" data-live-price>
                  <%= money.format(hasBids ? listing.current_bid : listing.starting_bid) %>
                </div>
                <div class="small" style="color:rgba(255,255,255,.6);margin-top:5px">
                  <span data-live-count><%= listing.bid_count %> bid<%= listing.bid_count === 1 ? '' : 's' %></span>
                  · next <span class="mono" style="color:#fff;font-weight:600"><%= money.formatShort(minimum) %></span>
                  <% if (listing.reserve_price) { %>
                    ·
                    <% if (listing.current_bid >= listing.reserve_price) { %>
                      <span style="color:#6FE3A0;font-weight:600">Reserve met</span>
                    <% } else { %>
                      <span style="color:#FFB27A;font-weight:600">Reserve not met</span>
                    <% } %>
                  <% } %>
                </div>
              </div>
              <% if (isHighBidder) { %>
                <span class="badge badge-success"><span class="dot"></span> You lead</span>
              <% } %>
            </div>

            <% if (live) { %>
              <div class="countdown <%= countdown.ms < 3600000 ? 'is-urgent' : '' %>"
                   data-countdown="<%= listing.auction_ends_at %>" data-countdown-units>
                <div class="countdown-unit"><div class="n" data-unit="d"><%= String(countdown.days).padStart(2,'0') %></div><div class="l">Days</div></div>
                <div class="countdown-unit"><div class="n" data-unit="h"><%= String(countdown.hours).padStart(2,'0') %></div><div class="l">Hrs</div></div>
                <div class="countdown-unit"><div class="n" data-unit="m"><%= String(countdown.minutes).padStart(2,'0') %></div><div class="l">Min</div></div>
                <div class="countdown-unit"><div class="n" data-unit="s"><%= String(countdown.seconds).padStart(2,'0') %></div><div class="l">Sec</div></div>
              </div>
              <p class="xsmall mono" style="color:rgba(255,255,255,.55);margin-top:9px">
                Ends <%= dates.formatDateTime(listing.auction_ends_at) %>
              </p>
            <% } %>
          </div>

          <div class="bidbox-body">
            <% if (!live) { %>
              <div class="alert alert-info mb-3">
                <div>
                  <% if (listing.status === 'sold') { %>
                    <strong>This cycle has been won.</strong> We may still have stock —
                    take it at the Buy Now price or contact us.
                  <% } else { %>
                    <strong>No auction running right now.</strong>
                    <% if (listing.keep_selling) { %>
                      A new cycle usually opens within the hour. You can buy it outright in the meantime.
                    <% } %>
                  <% } %>
                </div>
              </div>
            <% } else if (!currentUser) { %>
              <div class="alert alert-warning mb-3">
                <div><strong>Sign in to bid.</strong> Registration is free and takes under a minute.</div>
              </div>
              <a href="/login" class="btn btn-primary btn-block mb-1">Sign in to bid</a>
              <a href="/register" class="btn btn-ghost btn-block">Create an account</a>

            <% } else if (!eligibility.eligible) { %>
              <div class="alert alert-warning mb-3">
                <div><strong>One step first.</strong> <%= eligibility.message %></div>
              </div>
              <a href="<%= eligibility.reason === 'email' ? '/account/verify-email'
                        : (eligibility.reason === 'address' ? '/account/profile' : '/account/verification') %>"
                 class="btn btn-primary btn-block">
                <%= eligibility.reason === 'email' ? 'Confirm my email'
                    : (eligibility.reason === 'address' ? 'Add my address'
                    : (eligibility.reason === 'kyc_pending' ? 'Check verification status' : 'Verify my identity')) %>
              </a>

            <% } else { %>
              <form method="post" action="/lot/<%= listing.slug %>/bid" data-bid-form>
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">

                <label class="label" for="amount">
                  Your bid <span class="req">*</span>
                  <span class="muted" style="font-weight:500;text-transform:none;letter-spacing:0;float:right">
                    min <span data-live-minimum><%= money.format(minimum) %></span>
                  </span>
                </label>
                <div class="input-money">
                  <input class="input mono" type="number" id="amount" name="amount"
                         data-bid-input step="0.01" min="<%= minimum / 100 %>"
                         placeholder="<%= (minimum / 100).toFixed(2) %>" required>
                </div>

                <div class="row" style="gap:6px;margin-top:9px">
                  <% nextSteps.forEach(function (step) { %>
                    <button type="button" class="btn btn-ghost btn-sm btn-inline"
                            data-bid-step="<%= step / 100 %>"><%= money.formatShort(step) %></button>
                  <% }); %>
                </div>

                <label class="check" style="margin-top:16px">
                  <input type="checkbox" name="use_max" value="1" data-use-max
                         <%= myMaxBid ? 'checked' : '' %>>
                  <span>
                    <strong>Set a maximum bid</strong><br>
                    <span class="muted xsmall">We bid for you in <%= money.formatShort(listing.bid_increment) %> steps, only as high as needed, never above your ceiling.</span>
                  </span>
                </label>

                <div data-max-wrap class="hide" style="margin-top:12px">
                  <label class="label" for="max_amount">Maximum you will pay</label>
                  <div class="input-money">
                    <input class="input mono" type="number" id="max_amount" name="max_amount"
                           step="0.01" min="<%= minimum / 100 %>"
                           value="<%= myMaxBid ? (myMaxBid / 100).toFixed(2) : '' %>"
                           placeholder="<%= ((minimum + listing.bid_increment * 5) / 100).toFixed(2) %>">
                  </div>
                  <% if (myMaxBid) { %>
                    <p class="hint">Your current maximum is <%= money.format(myMaxBid) %>.</p>
                  <% } %>
                </div>

                <button type="submit" class="btn btn-primary btn-lg btn-block" style="margin-top:18px">
                  <%- include('../partials/icons', { icon: 'gavel', strokeWidth: 2 }) %>
                  Place bid
                </button>

                <p class="hint center" style="margin-top:11px">
                  Bidding is binding. Your purchase agreement is emailed for signature
                  the moment your bid is placed.
                </p>
              </form>
            <% } %>

            <!-- Buy now -->
            <div class="buynow-strip">
              <div>
                <div class="xsmall muted" style="letter-spacing:.12em;text-transform:uppercase;font-weight:700">Or buy it now</div>
                <div class="mono" style="font-family:var(--font-display);font-size:1.45rem;font-weight:700;line-height:1.15">
                  <%= money.format(listing.buy_now_price) %>
                </div>
              </div>
              <a href="/lot/<%= listing.slug %>/buy" class="btn btn-dark btn-inline">Buy now</a>
            </div>

            <% if (currentUser) { %>
              <form method="post" action="/lot/<%= listing.slug %>/watch" style="margin-top:12px">
                <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                <button type="submit" class="btn btn-ghost btn-block btn-sm">
                  <%- include('../partials/icons', { icon: 'heart', strokeWidth: 1.9 }) %>
                  <%= watching ? 'Remove from watchlist' : 'Add to watchlist' %>
                </button>
              </form>
            <% } %>
          </div>
        </div>

        <!-- Delivery estimate -->
        <div class="card card-pad mt-3">
          <div class="row" style="gap:9px;margin-bottom:6px">
            <span style="color:var(--blue)"><%- include('../partials/icons', { icon: 'truck', strokeWidth: 1.7 }) %></span>
            <strong class="small">Estimate delivery</strong>
          </div>
          <p class="xsmall muted mb-2">
            From <%= listing.location_city %>, <%= listing.location_state %> ·
            $<%= brand.terms.deliveryRatePerMile.toFixed(2) %>/mile
          </p>
          <form data-delivery-form="<%= listing.slug %>" class="row" style="gap:8px;flex-wrap:nowrap">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input class="input" type="text" inputmode="numeric" maxlength="5"
                   placeholder="Your ZIP code" data-delivery-zip aria-label="Your ZIP code">
            <button type="submit" class="btn btn-dark btn-inline">Calculate</button>
          </form>
          <div data-delivery-result></div>
        </div>

        <!-- Trust -->
        <div class="trust-grid mt-3">
          <% brand.trustBadges.forEach(function (badge) { %>
            <div class="trust-item">
              <%- include('../partials/icons', {
                icon: ({
                  'shield-check': 'shield', lock: 'lock', signature: 'signature',
                  headset: 'headset', 'rotate-left': 'rotate', certificate: 'cert',
                  clipboard: 'clipboard'
                })[badge.icon] || 'checkc',
                strokeWidth: 1.7
              }) %>
              <div class="l"><%= badge.label %></div>
            </div>
          <% }); %>
        </div>

        <!-- Contact -->
        <div class="card card-pad mt-3">
          <strong class="small">Questions about this machine?</strong>
          <p class="xsmall muted mt-1 mb-2">
            Ask for extra photos, a walk-around video or the full service history.
          </p>
          <a href="tel:<%= brand.contact.phoneHref %>" class="btn btn-ghost btn-block btn-sm mb-1">
            <%- include('../partials/icons', { icon: 'phone', strokeWidth: 1.9 }) %>
            <%= brand.contact.phone %>
          </a>
          <a href="/contact?subject=<%= encodeURIComponent('Enquiry: ' + listing.title) %>" class="btn btn-ghost btn-block btn-sm">
            <%- include('../partials/icons', { icon: 'mail', strokeWidth: 1.9 }) %>
            Email our team
          </a>
        </div>
      </aside>
    </div>
  </div>
</section>

<% if (related.length) { %>
  <section class="section section-alt">
    <div class="wrap">
      <div class="row-between mb-4">
        <div>
          <div class="eyebrow">You may also like</div>
          <h2 class="h2" style="margin-top:8px">Related equipment</h2>
        </div>
        <a href="/inventory" class="btn btn-ghost btn-inline">View all</a>
      </div>
      <div class="grid grid-3">
        <% related.forEach(function (lot) { %>
          <%- include('../partials/lot-card', { lot: lot }) %>
        <% }); %>
      </div>
    </div>
  </section>
<% } %>
