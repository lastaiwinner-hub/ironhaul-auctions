<section class="pagehead"><div class="wrap"><span class="eyebrow">THE RIGHT MACHINE FOR YOUR JOB</span><h1 class="h1">Compare your shortlist.</h1><p class="muted">See the facts side by side before you place your bid.</p></div></section><section class="section"><div class="wrap"><% if(!listings.length){ %><div class="room-empty"><h2>Start with a few contenders.</h2><p>Select “Compare machine” on up to three listings.</p><a class="btn btn-primary btn-inline" href="/auctions">Explore live auctions ↗</a></div><% } else { %><div class="comparison-scroll"><table class="comparison-table"><caption class="sr-only">Selected equipment comparison</caption><thead><tr><th scope="col">Machine</th><% listings.forEach(l=>{ %><th scope="col"><% if(l.primary_image){ %><img src="/uploads/listings/<%= l.primary_image %>" alt="<%= l.title %>" width="320" height="200"><% } %><a href="/lot/<%= l.slug %>"><%= l.title %></a></th><% }) %></tr></thead><tbody><% const fields=[['Current / opening bid',l=>money.format(l.bid_count?l.current_bid:l.starting_bid)],['Buy now',l=>money.format(l.buy_now_price)],['Year',l=>l.year||'Not supplied'],['Usage',l=>meterLabel(l)],['Power',l=>l.engine_hp?l.engine_hp+' HP':'Not supplied'],['Weight',l=>l.operating_weight?Number(l.operating_weight).toLocaleString('en-US')+' lbs':'Not supplied'],['Inspection grade',l=>l.inspection_grade?l.inspection_grade+' / 5':'Not supplied'],['Known faults',l=>l.known_faults||'Request condition notes'],['Included',l=>l.included_items||'Confirm with seller'],['Location',l=>[l.location_city,l.location_state].filter(Boolean).join(', ')||'To be confirmed']]; fields.forEach(([label,value])=>{ %><tr><th scope="row"><%= label %></th><% listings.forEach(l=>{ %><td><%= value(l) %></td><% }) %></tr><% }) %><tr><th scope="row">Next step</th><% listings.forEach(l=>{ %><td><a class="btn btn-primary btn-inline" href="/lot/<%= l.slug %>#bidding">View auction ↗</a></td><% }) %></tr></tbody></table></div><% } %></div></section>