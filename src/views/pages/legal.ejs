<section class="pagehead">
  <div class="wrap">
    <nav class="crumbs"><a href="/">Home</a><span class="sep">›</span><span class="current"><%= heading %></span></nav>
    <h1 class="h1"><%= heading %></h1>
    <p class="small" style="color:rgba(255,255,255,.6);margin-top:10px">Last updated <%= updated %></p>
  </div>
</section>

<section class="section">
  <div class="wrap wrap-narrow">
    <div class="card card-pad">
      <% sections.forEach(function (s, i) { %>
        <h2 class="h3" style="<%= i ? 'margin-top:34px;' : '' %>margin-bottom:12px"><%= s.heading %></h2>
        <% s.paragraphs.forEach(function (p) { %>
          <p style="line-height:1.78;margin-bottom:13px"><%- p %></p>
        <% }); %>
      <% }); %>

      <div class="alert alert-info mt-4">
        <div>
          Questions about this document? Email
          <a href="mailto:<%= brand.contact.email %>" style="font-weight:700"><%= brand.contact.email %></a>
          or call <%= brand.contact.phone %>.
        </div>
      </div>
    </div>
  </div>
</section>
