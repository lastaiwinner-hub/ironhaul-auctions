<%
const spotlightPool = featured.filter(l => l.make === 'Caterpillar').concat(featured.filter(l => l.make !== 'Caterpillar'));
const spotlights = (spotlightPool.length ? spotlightPool : endingSoon).slice(0, 2);
const shelf = endingSoon.slice(0, 8);
%>
<section class="dealer-hero">
 <img class="dealer-backdrop" src="/img/brand-hero.webp" alt="Excavator photographed at a construction site" width="1800" height="1000" fetchpriority="high">
 <div class="wrap dealer-hero-grid">
  <div class="dealer-pitch"><span class="dealer-eyebrow"><span class="live-dot"></span>QUALITY USED EQUIPMENT. OPEN FOR BIDDING.</span><h1>THE RIGHT IRON.<br>THE NEXT BIG JOB.<br><em>LET’S GET TO WORK.</em></h1><p>Excavators, loaders, dozers and more. Explore the inventory, get to know every machine, and choose how you buy — bid online or buy it outright.</p><div class="dealer-hero-actions"><a href="#live-auctions" class="action action-accent action-large">Browse equipment<span aria-hidden="true">→</span></a><a href="/how-it-works" class="action action-glass">How buying works</a></div><div class="dealer-guarantees"><span><%- include('../partials/icons',{icon:'shield'}) %><%= brand.terms.inspectionDays %>-day inspection</span><span><%- include('../partials/icons',{icon:'cert'}) %><%= brand.terms.warrantyMonths %>-month warranty</span><span><%- include('../partials/icons',{icon:'truck'}) %>Delivery available</span></div></div>
  <div class="spotlight-area"><div class="spotlight-label"><span>IN THE SPOTLIGHT</span><a href="/inventory">View inventory ↗</a></div><div class="spotlight-grid"><% spotlights.forEach(lot=>{ %><%- include('../partials/spotlight-card',{lot}) %><% }); %><% if(!spotlights.length){ %><div class="spotlight-empty"><h2>Your next opportunity is on its way.</h2><a href="/inventory" class="action action-accent">Explore inventory →</a></div><% } %></div></div>
 </div><div class="wrap hero-footnote"><span>Built for operators. Backed by the details.</span><a href="/photo-credits">Campaign image credits</a></div>
</section>
<div class="dealer-trustbar"><div class="wrap"><div><strong><%= stats.live %></strong><span>equipment in inventory</span></div><div><strong><%= brand.terms.buyerPremiumPercent %>%</strong><span>buyer premium</span></div><div><%- include('../partials/icons',{icon:'clipboard'}) %><span>Specifications & condition details</span></div><a href="/contact"><%- include('../partials/icons',{icon:'phone'}) %><span>Real questions.<br><b>A direct line to our team.</b></span><span class="trust-arrow">↗</span></a></div></div>
<section class="iron-makes wrap"><div><span class="section-kicker">PROVEN NAMES. REAL POSSIBILITIES.</span><h2>Shop equipment by make.</h2></div><div class="iron-make-logos"><% [{n:'Caterpillar',f:'caterpillar.svg'},{n:'John Deere',f:'deere.png'},{n:'Kubota',f:'kubota.svg'},{n:'Hitachi',f:'hitachi.svg'}].forEach(m=>{ %><a href="/inventory?make=<%= encodeURIComponent(m.n) %>" aria-label="Browse <%= m.n %> equipment"><img src="/img/makes/<%= m.f %>" alt="<%= m.n %>" width="145" height="45" loading="lazy"><span>Browse equipment ↗</span></a><% }); %></div></section><section class="auction-market" id="live-auctions"><div class="wrap">
 <div class="market-title"><div><span class="section-kicker">FIND YOUR NEXT WORKHORSE</span><h2>EQUIPMENT ON THE BLOCK<span class="accent-period">.</span></h2></div><a class="link-arrow" href="/inventory">View all equipment <span>↗</span></a></div>
 <form class="auction-search discovery-form" action="/inventory" method="get"><div class="search-query"><%- include('../partials/icons',{icon:'search'}) %><label class="sr-only" for="home-query">Search equipment</label><input id="home-query" name="q" type="search" placeholder="Search equipment, make, model…"></div><div><label class="sr-only" for="home-make">Make</label><select id="home-make" name="make"><option value="">All makes</option><% facets.makes.forEach(m=>{ %><option value="<%= m.make %>"><%= m.make %></option><% }); %></select></div><div><label class="sr-only" for="home-category">Category</label><select id="home-category" name="category"><option value="">All categories</option><% categories.forEach(c=>{ %><option value="<%= c.slug %>"><%= c.name %></option><% }); %></select></div><button class="action action-dark" type="submit">Find equipment <span aria-hidden="true">→</span></button></form>
 <div class="auction-toolbar"><div class="auction-tabs" aria-label="Filter featured auctions"><button type="button" class="is-active" data-auction-filter="all" aria-pressed="true">All auctions <span><%= shelf.length %></span></button><button type="button" data-auction-filter="ending" aria-pressed="false">Ending today</button><button type="button" data-auction-filter="no-reserve" aria-pressed="false">No reserve</button><button type="button" data-auction-filter="popular" aria-pressed="false">Most bids</button></div><span class="sync-label" data-auction-sync><span class="live-dot"></span> Auction overview</span></div>
 <% if(shelf.length) { %><div class="auction-grid market-grid" data-auction-grid><% shelf.forEach(lot=>{ %><%- include('../partials/auction-card',{lot}) %><% }); %></div><div class="filter-empty" hidden data-filter-empty><h3>No matching auctions in this selection.</h3><a href="/inventory" class="link-arrow">Explore the full inventory →</a></div><% } else { %><div class="filter-empty"><h3>No live auctions right now</h3><p>Browse available equipment or sign up for new listing alerts.</p><a href="/inventory" class="action action-dark">Explore inventory</a></div><% } %>
 <div class="market-bottom"><p>Catalogue images may be representative. <a href="/photo-credits">Photography details</a></p><a href="/inventory?filter=auction" class="action action-outline">See all live auctions <span>↗</span></a></div>
</div></section>
<% const categoryPhotos={excavators:'2021-caterpillar-320-hydraulic-excavator-1.jpg','mini-excavators':'2019-hitachi-zx30u-5n-mini-excavator-1.jpg',dozers:'2019-caterpillar-d3k2-lgp-dozer-2.jpg','wheel-loaders':'2020-john-deere-544l-wheel-loader-1.jpg','skid-steers':'2021-john-deere-333g-compact-track-loader-1.jpg','backhoe-loaders':'2018-new-holland-b95c-backhoe-loader-1.jpg'}; %>
<section class="iron-photo-categories" id="equipment-categories"><div class="wrap"><div class="market-title"><div><span class="section-kicker">EQUIPMENT FOR THE WORK AHEAD</span><h2>FIND THE RIGHT MACHINE<span class="accent-period">.</span></h2></div><p>From the first dig to the finishing touches.<br>Explore equipment by the job it needs to do.</p></div><div class="iron-photo-grid"><% categories.slice(0,6).forEach((c,i)=>{ %><a class="iron-photo-card" href="/inventory?category=<%= c.slug %>"><div class="iron-category-photo"><img src="/uploads/listings/<%= categoryPhotos[c.slug] %>" alt="<%= c.name %> — representative equipment photograph" width="720" height="480" loading="lazy"><span class="iron-category-number">0<%= i+1 %> / EQUIPMENT</span></div><div class="iron-category-label"><div><h3><%= c.name %></h3><p><%= c.listing_count %> <%= Number(c.listing_count) === 1 ? 'machine' : 'machines' %> in inventory</p></div><span class="iron-category-arrow" aria-hidden="true">↗</span></div></a><% }); %></div><p class="iron-category-note">Real equipment photography. Category images are representative. <a href="/photo-credits">Image credits ↗</a></p></div></section>
<section class="dealer-story"><div class="wrap story-grid"><div class="story-photo"><img src="/img/editorial-hero.webp" alt="Representative excavator photograph" width="800" height="720" loading="lazy"><div class="story-stamp"><span><%= brand.shortName %></span><strong>SERIOUS ABOUT EQUIPMENT.</strong></div></div><div class="story-copy"><span class="section-kicker">MORE THAN A LISTING. A CLEARER WAY TO BUY.</span><h2>GOOD EQUIPMENT.<br>STRAIGHT ANSWERS.</h2><p>Your next machine has a job to do. We put the information, buying options and support in one place so you can make a considered decision.</p><ul><li><span class="story-check"><%- include('../partials/icons',{icon:'check'}) %></span><div><h3>The details before the decision</h3><p>Specifications, condition information and disclosed faults, ready to review before you bid.</p></div></li><li><span class="story-check"><%- include('../partials/icons',{icon:'check'}) %></span><div><h3>A person you can talk to</h3><p>Questions about a stock number, the buying process or delivery? Contact our team.</p></div></li><li><span class="story-check"><%- include('../partials/icons',{icon:'check'}) %></span><div><h3>A plan beyond the purchase</h3><p>Digital agreements, delivery coordination and a <%= brand.terms.inspectionDays %>-day inspection window.</p></div></li></ul><a class="action action-dark" href="/about">Get to know <%= brand.shortName %> <span>↗</span></a></div></div></section><section class="steps-section"><div class="wrap"><div class="market-title"><div><span class="section-kicker">YOUR NEXT WIN STARTS HERE</span><h2>Four steps. One great find.</h2></div><a href="/faq" class="link-arrow">Your questions, answered ↗</a></div><div class="buying-steps"><% [{n:'01',i:'search',t:'Find your fit',d:'Explore the inventory. Compare the details. Save your shortlist.'},{n:'02',i:'user',t:'Get ready to bid',d:'Create your account and complete identity verification.'},{n:'03',i:'gavel',t:'Make your move',d:'Place a bid, set your maximum, or choose Buy Now.'},{n:'04',i:'truck',t:'Make it yours',d:'Complete your agreement and arrange your delivery.'}].forEach(s=>{ %><div><div class="iron-step-top"><span class="step-number"><%= s.n %></span><%- include('../partials/icons',{icon:s.i}) %></div><h3><%= s.t %></h3><p><%= s.d %></p></div><% }); %></div></div></section>
<section class="delivery-section"><div class="wrap delivery-grid"><div><span class="section-kicker">PLAN THE WHOLE PURCHASE</span><h2>FROM OUR INVENTORY.<br>TO YOUR NEXT JOB.</h2><p>Explore delivery to <%= brand.terms.deliveryRegion %>. Start with a mileage estimate, then speak to our team about your route and final quote.</p><div class="delivery-points"><span><%- include('../partials/icons',{icon:'signature'}) %> Digital agreements</span><span><%- include('../partials/icons',{icon:'truck'}) %> Delivery coordination</span><span><%- include('../partials/icons',{icon:'clipboard'}) %> Inspection on arrival</span></div></div><form class="delivery-calculator" data-mileage-estimator data-rate="<%= brand.terms.deliveryRatePerMile %>"><div class="calculator-title"><%- include('../partials/icons',{icon:'truck'}) %><h3>Plan your delivery</h3><span>ESTIMATE</span></div><label for="delivery-miles">Approximate transport distance</label><div class="mileage-input"><input id="delivery-miles" type="number" name="miles" value="250" min="1" max="10000" step="1" inputmode="numeric" required><span>miles</span><button type="submit" class="action action-dark">Calculate</button></div><div class="delivery-estimate"><span>At <%= money.format(Math.round(brand.terms.deliveryRatePerMile * 100)) %> per mile</span><output data-mileage-total aria-live="polite"><%= money.format(Math.round(250 * brand.terms.deliveryRatePerMile * 100)) %></output></div><p>Planning estimate only. Confirm the route and total with our team.</p><a class="link-arrow" href="/contact">Discuss your delivery →</a></form></div></section>
<section class="dealer-faq"><div class="wrap faq-dealer-grid"><div><span class="section-kicker">BEFORE YOU MAKE YOUR MOVE</span><h2>GOOD QUESTIONS.<br>CLEAR ANSWERS.</h2><p>Get familiar with bidding, verification and buying outright.</p><a href="/faq" class="link-arrow">Explore all buying questions ↗</a><a class="faq-call" href="tel:<%= brand.contact.phoneHref %>"><%- include('../partials/icons',{icon:'phone'}) %><span>Rather talk it through?<strong><%= brand.contact.phone %></strong></span></a></div><div class="dealer-questions"><% homeFaq.slice(0,4).forEach((item,i)=>{ %><details <%= i===0?'open':'' %>><summary><%= item.q %><span aria-hidden="true">+</span></summary><p><%= item.a %></p></details><% }); %></div></div></section><section class="newsletter-section" id="alerts"><div class="wrap newsletter-inner"><div><span class="section-kicker">DON’T MISS YOUR NEXT OPPORTUNITY</span><h2>The right machine.<br>Right in your inbox.</h2><p>Tell us what you’re looking for. We’ll keep you in the loop.</p></div><form method="post" action="/alerts"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label for="wanted">What’s on your list?</label><input id="wanted" name="wanted" placeholder="e.g. Excavator under 3,000 hours"><label for="alert-email">Email address</label><div class="subscribe-row"><input id="alert-email" name="email" type="email" placeholder="you@example.com" required><button type="submit" class="action action-accent">Keep me posted ↗</button></div></form></div></section>
