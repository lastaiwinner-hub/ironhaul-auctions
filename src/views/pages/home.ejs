<%
const heroLot = endingSoon[0];
const heroCd = heroLot ? dates.countdown(heroLot.auction_ends_at) : null;
const shelf = endingSoon.slice(0, 8);
%>
<section class="auction-hero">
  <img class="hero-landscape" src="/img/brand-hero.webp" alt="Excavator on a sunlit construction site" width="1800" height="1000" fetchpriority="high">
  <div class="hero-shade"></div>
  <div class="wrap hero-content">
    <div class="hero-pitch"><div class="hero-eyebrow"><span class="live-dot"></span> THE MARKETPLACE FOR PEOPLE WHO BUILD</div><h1>Serious iron.<br>Real opportunity.</h1><p>The next addition to your fleet is on the block. Explore heavy equipment auctions, compare the details, and bid with a plan.</p><div class="hero-buttons"><a href="#live-auctions" class="action action-accent action-large">Explore auctions <span aria-hidden="true">↗</span></a><a href="/how-it-works" class="action action-glass"><span class="play-circle" aria-hidden="true">▶</span> How bidding works</a></div><div class="hero-assurances"><span><%- include('../partials/icons',{icon:'shield'}) %> Identity-verified bidders</span><span><%= brand.terms.buyerPremiumPercent %>% buyer premium</span></div></div>
    <% if (heroLot) { %>
    <a class="hero-auction" href="/lot/<%= heroLot.slug %>" data-auction="<%= heroLot.slug %>"><div class="hero-auction-top"><span class="live-label"><span class="live-dot"></span> NEXT ON THE BLOCK</span><span aria-hidden="true">↗</span></div><div class="hero-auction-item"><% if (heroLot.primary_image) { %><img src="/uploads/listings/<%= heroLot.primary_image %>" alt="" width="88" height="68"><% } %><div><span class="micro"><%= heroLot.category_name %></span><h2><%= heroLot.title %></h2></div></div><div class="hero-auction-values"><div><span class="micro">Current bid</span><strong data-auction-price><%= money.formatShort(heroLot.current_bid || heroLot.starting_bid) %></strong></div><div class="hero-timer" data-countdown="<%= heroLot.auction_ends_at %>"><span class="micro">Time remaining</span><strong data-countdown-label><%= heroCd.label %></strong></div></div><div class="hero-auction-bottom"><span><span data-auction-bids><%= heroLot.bid_count || 0 %></span> bids placed</span><span>View auction →</span></div></a>
    <% } %>
    <a class="hero-credit" href="/photo-credits">Campaign photography · image credits</a>
  </div>
</section>
<div class="platform-strip"><div class="wrap"><div><strong><%= stats.auctions %></strong><span>Auctions open for bidding</span></div><div><strong><%= brand.terms.buyerPremiumPercent %>%</strong><span>Buyer premium. More for you.</span></div><div><%- include('../partials/icons',{icon:'clipboard'}) %><span>Detailed equipment condition reports</span></div><div><%- include('../partials/icons',{icon:'truck'}) %><span>Delivery to your door</span></div></div></div>
<section class="auction-market" id="live-auctions"><div class="wrap">
 <div class="market-title"><div><span class="section-kicker">FIND YOUR NEXT WORKHORSE</span><h2>Ready for your next big move<span class="accent-period">.</span></h2></div><a class="link-arrow" href="/inventory">View all equipment <span>↗</span></a></div>
 <form class="auction-search discovery-form" action="/inventory" method="get"><div class="search-query"><%- include('../partials/icons',{icon:'search'}) %><label class="sr-only" for="home-query">Search equipment</label><input id="home-query" name="q" type="search" placeholder="Search equipment, make, model…"></div><div><label class="sr-only" for="home-make">Make</label><select id="home-make" name="make"><option value="">All makes</option><% facets.makes.forEach(m=>{ %><option value="<%= m.make %>"><%= m.make %></option><% }); %></select></div><div><label class="sr-only" for="home-category">Category</label><select id="home-category" name="category"><option value="">All categories</option><% categories.forEach(c=>{ %><option value="<%= c.slug %>"><%= c.name %></option><% }); %></select></div><button class="action action-dark" type="submit">Find equipment <span aria-hidden="true">→</span></button></form>
 <div class="auction-toolbar"><div class="auction-tabs" aria-label="Filter featured auctions"><button type="button" class="is-active" data-auction-filter="all" aria-pressed="true">All auctions <span><%= shelf.length %></span></button><button type="button" data-auction-filter="ending" aria-pressed="false">Ending today</button><button type="button" data-auction-filter="no-reserve" aria-pressed="false">No reserve</button><button type="button" data-auction-filter="popular" aria-pressed="false">Most bids</button></div><span class="sync-label" data-auction-sync><span class="live-dot"></span> Auction overview</span></div>
 <% if(shelf.length) { %><div class="auction-grid market-grid" data-auction-grid><% shelf.forEach(lot=>{ %><%- include('../partials/auction-card',{lot}) %><% }); %></div><div class="filter-empty" hidden data-filter-empty><h3>No matching auctions in this selection.</h3><a href="/inventory" class="link-arrow">Explore the full inventory →</a></div><% } else { %><div class="filter-empty"><h3>No live auctions right now</h3><p>Browse available equipment or sign up for new listing alerts.</p><a href="/inventory" class="action action-dark">Explore inventory</a></div><% } %>
 <div class="market-bottom"><p>Catalogue images may be representative. <a href="/photo-credits">Photography details</a></p><a href="/inventory?filter=auction" class="action action-outline">See all live auctions <span>↗</span></a></div>
</div></section>
<section class="category-section"><div class="wrap"><div class="market-title"><div><span class="section-kicker">THE RIGHT FIT FOR YOU</span><h2>Built for every kind of job<span class="accent-period">.</span></h2></div><span class="section-description">From the first dig to the finishing touches.</span></div><div class="category-grid"><% categories.slice(0,6).forEach(c=>{ %><a class="category-card" href="/inventory?category=<%= c.slug %>"><span class="category-icon"><%- include('../partials/icons',{icon:c.icon || 'excavator'}) %></span><span><strong><%= c.name %></strong><small><%= c.listing_count %> available</small></span><span class="category-arrow">↗</span></a><% }); %></div></div></section>
<section class="buyer-section"><div class="wrap buyer-grid"><div class="buyer-heading"><span class="section-kicker">EVERY BID IS A BIG DECISION</span><h2>Bid with knowledge.<br>Buy with confidence.</h2><p>Know what you’re buying. Understand the process. Have a team to turn to along the way.</p><a class="action action-accent" href="/how-it-works">Get to know the process <span>↗</span></a></div><div class="buyer-reasons"><% [{icon:'clipboard',title:'The details that matter',desc:'Study the specifications, condition and disclosed faults before you commit.'},{icon:'idcard',title:'Real people. Verified bidders.',desc:'One account. Identity verification. A clear path from your first bid to your next purchase.'},{icon:'truck',title:'Support beyond the winning bid',desc:'Digital agreements and delivery coordination, with a team you can contact.'}].forEach((item,i)=>{ %><div class="buyer-reason"><span class="reason-icon"><%- include('../partials/icons',{icon:item.icon}) %></span><div><h3><%= item.title %></h3><p><%= item.desc %></p></div><span class="reason-number">0<%= i+1 %></span></div><% }); %></div></div></section>
<section class="steps-section"><div class="wrap"><div class="market-title"><div><span class="section-kicker">YOUR NEXT WIN STARTS HERE</span><h2>Four steps. One great find.</h2></div><a href="/faq" class="link-arrow">Your questions, answered ↗</a></div><div class="buying-steps"><% [{n:'01',t:'Find your fit',d:'Explore the inventory. Compare the details. Save your shortlist.'},{n:'02',t:'Get ready to bid',d:'Create your account and complete identity verification.'},{n:'03',t:'Make your move',d:'Place a bid, set your maximum, or choose Buy Now.'},{n:'04',t:'Make it yours',d:'Complete your agreement and arrange your delivery.'}].forEach(s=>{ %><div><span class="step-number"><%= s.n %></span><h3><%= s.t %></h3><p><%= s.d %></p></div><% }); %></div></div></section>
<section class="newsletter-section" id="alerts"><div class="wrap newsletter-inner"><div><span class="section-kicker">DON’T MISS YOUR NEXT OPPORTUNITY</span><h2>The right machine.<br>Right in your inbox.</h2><p>Tell us what you’re looking for. We’ll keep you in the loop.</p></div><form method="post" action="/alerts"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><label for="wanted">What’s on your list?</label><input id="wanted" name="wanted" placeholder="e.g. Excavator under 3,000 hours"><label for="alert-email">Email address</label><div class="subscribe-row"><input id="alert-email" name="email" type="email" placeholder="you@example.com" required><button type="submit" class="action action-accent">Keep me posted ↗</button></div></form></div></section>
