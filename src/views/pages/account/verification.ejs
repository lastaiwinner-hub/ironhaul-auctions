<%
const DOCS = [
  { key: 'id_front', title: 'ID — front', icon: 'idcard',
    hint: 'Driver licence, passport or state ID. All four corners visible, no glare.' },
  { key: 'id_back', title: 'ID — back', icon: 'idcard',
    hint: 'The reverse of the same document. Skip only if using a passport photo page.' },
  { key: 'selfie', title: 'Selfie', icon: 'camera',
    hint: 'A clear photo of your face in good light. Holding your ID up is ideal.' },
];
const status = currentUser.kyc_status;
%>

<section class="section-sm" style="background:var(--surface);border-bottom:1px solid var(--line)">
  <div class="wrap">
    <div class="eyebrow">Step 2 of 2</div>
    <h1 class="h2" style="margin-top:6px">Verify your identity</h1>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="acct-layout">
      <%- include('../../partials/account-nav') %>

      <div style="max-width:760px">
        <!-- Status banner -->
        <% if (status === 'approved') { %>
          <div class="alert alert-success mb-4">
            <span style="flex:none"><%- include('../../partials/icons', { icon: 'checkc', strokeWidth: 2 }) %></span>
            <div>
              <strong>You are verified.</strong> Your account is cleared to place bids
              and complete Buy Now purchases.
              <div class="row mt-2">
                <a href="/inventory?filter=auction" class="btn btn-success btn-sm btn-inline">See live auctions</a>
              </div>
            </div>
          </div>
        <% } else if (status === 'pending') { %>
          <div class="alert alert-info mb-4">
            <span style="flex:none"><%- include('../../partials/icons', { icon: 'clock', strokeWidth: 2 }) %></span>
            <div>
              <strong>Your documents are in review.</strong> Our team checks submissions
              during business hours — usually within a few hours. We will email you the
              moment your account is cleared.
              <div class="xsmall muted mt-1">
                Submitted <%= dates.formatDateTime(currentUser.kyc_submitted_at) %>
              </div>
            </div>
          </div>
        <% } else if (status === 'rejected') { %>
          <div class="alert alert-error mb-4">
            <span style="flex:none"><%- include('../../partials/icons', { icon: 'warning', strokeWidth: 2 }) %></span>
            <div>
              <strong>We could not verify your documents.</strong>
              <div style="margin-top:6px"><%= currentUser.kyc_rejection_reason || 'The documents could not be read clearly.' %></div>
              <div style="margin-top:8px">Please upload replacements below.</div>
            </div>
          </div>
        <% } else if (!currentUser.email_verified) { %>
          <div class="alert alert-warning mb-4">
            <div>
              <strong>Confirm your email first.</strong>
              <a href="/account/verify-email" style="font-weight:700">Resend the confirmation link</a>.
            </div>
          </div>
        <% } %>

        <!-- Why -->
        <div class="card card-pad mb-4">
          <div class="row" style="gap:11px;margin-bottom:12px">
            <span style="color:var(--accent-ink)"><%- include('../../partials/icons', { icon: 'shield', strokeWidth: 1.7 }) %></span>
            <h2 class="h4" style="margin:0">Why we ask for this</h2>
          </div>
          <p class="small muted" style="line-height:1.7">
            A bid is a binding commitment to buy, so we confirm who is making it.
            Verification keeps fake accounts and time-wasters out of the auction,
            which protects the price for buyers who are serious.
          </p>
          <div class="grid grid-3 mt-3" style="gap:12px">
            <% [
              { icon: 'lock',   t: 'Stored securely', d: 'Held outside the public web, never linked publicly.' },
              { icon: 'eye',    t: 'Seen by few',     d: 'Only the verification team can open your documents.' },
              { icon: 'pin',    t: 'Location stripped', d: 'GPS metadata is removed from every image on upload.' }
            ].forEach(function (f) { %>
              <div style="padding:14px;background:var(--surface-alt);border-radius:var(--radius-sm)">
                <span style="color:var(--muted)"><%- include('../../partials/icons', { icon: f.icon, strokeWidth: 1.7 }) %></span>
                <div class="small" style="font-weight:700;margin:8px 0 3px"><%= f.t %></div>
                <div class="xsmall muted" style="line-height:1.5"><%= f.d %></div>
              </div>
            <% }); %>
          </div>
        </div>

        <!-- Upload -->
        <form method="post" action="/account/verification" enctype="multipart/form-data">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">

          <div class="card card-pad">
            <h2 class="h3 mb-1">Upload your documents</h2>
            <p class="muted small mb-3">
              JPG, PNG or HEIC, up to 12&nbsp;MB each. All three are required.
            </p>

            <div class="upload-grid">
              <% DOCS.forEach(function (doc) { %>
                <% const existing = documents[doc.key]; %>
                <label class="upload-tile <%= existing ? 'is-done' : '' %>" data-upload-tile>
                  <% if (existing) { %>
                    <img class="upload-preview" data-upload-preview
                         src="/account/verification/<%= doc.key %>/preview" alt="<%= doc.title %>">
                  <% } else { %>
                    <img class="upload-preview hide" data-upload-preview alt="">
                  <% } %>

                  <span data-upload-icon class="<%= existing ? 'hide' : '' %>">
                    <span class="upload-icon" style="display:block">
                      <%- include('../../partials/icons', { icon: doc.icon, strokeWidth: 1.4 }) %>
                    </span>
                  </span>

                  <div class="upload-name">
                    <%= doc.title %>
                    <% if (existing) { %>
                      <span style="color:var(--success)">✓</span>
                    <% } %>
                  </div>
                  <div class="upload-hint" data-upload-filename>
                    <%= existing ? 'Uploaded — tap to replace' : doc.hint %>
                  </div>

                  <input type="file" name="<%= doc.key %>"
                         accept="image/jpeg,image/png,image/webp,image/heic,image/heif"
                         <%= ['pending','approved'].includes(status) ? 'disabled' : '' %>>
                </label>
              <% }); %>
            </div>

            <div class="alert alert-warning mt-3">
              <div class="small">
                <strong>Before you upload, check:</strong>
                all four corners of the ID are in frame · the text is sharp and readable ·
                no glare across the photo · the document has not expired ·
                your name matches <strong><%= currentUser.full_name %></strong>.
              </div>
            </div>

            <% if (!['pending','approved'].includes(status)) { %>
              <button type="submit" class="btn btn-primary btn-lg btn-block mt-3">
                <%- include('../../partials/icons', { icon: 'upload', strokeWidth: 2 }) %>
                <%= missing.length ? 'Upload documents' : 'Submit for review' %>
              </button>
              <% if (missing.length && missing.length < 3) { %>
                <p class="hint center mt-2">
                  Still needed:
                  <%= missing.map(function (m) {
                        return ({ id_front: 'front of ID', id_back: 'back of ID', selfie: 'selfie' })[m] || m;
                      }).join(', ') %>
                </p>
              <% } %>
            <% } else { %>
              <p class="hint center mt-3">
                <%= status === 'approved'
                    ? 'Your documents are verified. Contact us if you need to update them.'
                    : 'Your documents are locked while under review.' %>
              </p>
            <% } %>
          </div>
        </form>

        <div class="card card-pad mt-3">
          <p class="small muted">
            Need help, or does your situation not fit the standard documents?
            Call <a href="tel:<%= brand.contact.phoneHref %>" style="color:var(--accent-ink);font-weight:700"><%= brand.contact.phone %></a>
            or email <a href="mailto:<%= brand.contact.email %>" style="color:var(--accent-ink);font-weight:700"><%= brand.contact.email %></a>.
          </p>
        </div>
      </div>
    </div>
  </div>
</section>
