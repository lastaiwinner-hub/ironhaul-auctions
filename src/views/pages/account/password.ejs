<section class="section-sm" style="background:var(--surface);border-bottom:1px solid var(--line)">
  <div class="wrap">
    <div class="eyebrow">Your account</div>
    <h1 class="h2" style="margin-top:6px">Change your password</h1>
  </div>
</section>

<section class="section">
  <div class="wrap">
    <div class="acct-layout">
      <%- include('../../partials/account-nav') %>

      <div style="max-width:520px">
        <div class="card card-pad">
          <form method="post" action="/account/password" novalidate>
            <input type="hidden" name="_csrf" value="<%= csrfToken %>">

            <div class="field">
              <label class="label" for="current_password">Current password</label>
              <input class="input <%= errors.current_password ? 'input-error' : '' %>" type="password"
                     id="current_password" name="current_password" autocomplete="current-password" required>
              <% if (errors.current_password) { %><div class="error-text"><%= errors.current_password %></div><% } %>
            </div>

            <div class="field">
              <label class="label" for="password">New password</label>
              <input class="input <%= errors.password ? 'input-error' : '' %>" type="password"
                     id="password" name="password" autocomplete="new-password" required>
              <% if (errors.password) { %><div class="error-text"><%= errors.password %></div><% } %>
              <p class="hint">At least 10 characters, including a letter and a number.</p>
            </div>

            <div class="field">
              <label class="label" for="password_confirm">Confirm new password</label>
              <input class="input <%= errors.password_confirm ? 'input-error' : '' %>" type="password"
                     id="password_confirm" name="password_confirm" autocomplete="new-password" required>
              <% if (errors.password_confirm) { %><div class="error-text"><%= errors.password_confirm %></div><% } %>
            </div>

            <div class="row">
              <button type="submit" class="btn btn-primary">Update password</button>
              <a href="/account/profile" class="btn btn-ghost btn-inline">Cancel</a>
            </div>
          </form>
        </div>
      </div>
    </div>
  </div>
</section>
