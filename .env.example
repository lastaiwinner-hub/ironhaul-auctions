# ============================================================================
#  IronHaul Auctions — environment configuration
#  Copy to .env and fill in. Never commit .env to version control.
# ============================================================================

# ---- Core ------------------------------------------------------------------
NODE_ENV=development
PORT=3010
HOST=0.0.0.0

# The public URL of this site, with no trailing slash. This is used to build
# every link in every email — including the purchase agreement signing links —
# so it MUST be correct in production or buyers will receive dead links.
BASE_URL=http://localhost:3010

# Set to 1 when running behind nginx, Caddy or any reverse proxy, so that
# client IPs, secure cookies and rate limiting read the X-Forwarded-* headers.
TRUST_PROXY=0

# ---- Security --------------------------------------------------------------
# REQUIRED in production — at least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

SESSION_COOKIE_NAME=ironhaul.sid
SESSION_MAX_AGE_DAYS=14
BCRYPT_ROUNDS=12
MAX_LOGIN_ATTEMPTS=8
LOGIN_WINDOW_MINUTES=15
EMAIL_VERIFY_HOURS=48
PASSWORD_RESET_HOURS=2

# ---- Database --------------------------------------------------------------
# Absolute path recommended in production, e.g. /var/www/ironhaul/data/ironhaul.sqlite
DATABASE_FILE=

# ---- Uploads ---------------------------------------------------------------
MAX_UPLOAD_MB=12

# ---- Email (SMTP) ----------------------------------------------------------
# Leave SMTP_HOST blank during development: every message is then rendered and
# written to logs/mail as an .eml file instead of being sent, so the whole
# bidding and agreement flow is testable with no credentials.
#
# For production use a transactional provider with a verified sending domain
# and SPF, DKIM and DMARC records in place. Examples:
#   Postmark    smtp.postmarkapp.com        port 587
#   SendGrid    smtp.sendgrid.net           port 587
#   Mailgun     smtp.mailgun.org            port 587
#   Amazon SES  email-smtp.<region>.amazonaws.com  port 587
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

MAIL_FROM_NAME=IronHaul Auctions
MAIL_FROM_EMAIL=no-reply@ironhaul-auctions.com
MAIL_REPLY_TO=sales@ironhaul-auctions.com

# Where operational alerts go: new KYC submissions, signed agreements,
# Buy Now orders and auction results.
ADMIN_NOTIFY_EMAIL=sales@ironhaul-auctions.com

# ---- First administrator ---------------------------------------------------
# Used once, by `npm run seed`, to create the initial admin account.
# CHANGE THE PASSWORD before running seed on a public server.
ADMIN_EMAIL=admin@ironhaul-auctions.com
ADMIN_PASSWORD=ChangeMe!2026
ADMIN_NAME=Platform Administrator

# ---- Background jobs -------------------------------------------------------
# Closes ended auctions, declares winners, sends emails and relists stock.
# Leave enabled. If you ever run more than one app process, enable it on
# exactly ONE of them so auctions are not settled twice.
SCHEDULER_ENABLED=true
