{
  "name": "ironhaul-auctions",
  "version": "1.0.0",
  "private": true,
  "description": "IronHaul Auctions — online auction and instant-buy platform for excavators and heavy equipment, with KYC verification, live bidding and automated e-signed purchase agreements.",
  "main": "server.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node db/migrate.js",
    "seed": "node db/seed.js",
    "seed:images": "node db/fetch-images.js",
    "setup": "npm run migrate && npm run seed:images && npm run seed",
    "reset": "node db/reset.js && npm run setup"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "better-sqlite3": "^12.2.0",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-ejs-layouts": "^2.5.1",
    "express-rate-limit": "^7.5.0",
    "express-session": "^1.18.1",
    "helmet": "^8.0.0",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^6.9.16",
    "pdfkit": "^0.15.1",
    "sharp": "^0.33.5"
  }
}
